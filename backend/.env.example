# ============================================================
# BizRadar — локальный запуск бэкенда БЕЗ Docker
# Скопируйте в backend/.env и заполните.
# В проде секреты живут в корневом .env.production.
# ============================================================

# Провайдер генерации бизнес-отчётов:
#   stub     — локальная эвристика-заглушка, работает без ключей и без сети
#   gigachat — реальный вызов GigaChat; при любой ошибке сервис сам
#              откатится на заглушку, эндпоинт не упадёт
LLM_PROVIDER=stub

# Долгоживущий авторизационный ключ GigaChat (developers.sber.ru).
# НЕ коммитьте .env в git!
GIGACHAT_AUTH_KEY=

# Модель: GigaChat (базовая) | GigaChat Pro | GigaChat Max
GIGACHAT_MODEL=GigaChat

# Scope: GIGACHAT_API_CORP (юрлицо) | GIGACHAT_API_PERS (физлицо)
GIGACHAT_SCOPE=GIGACHAT_API_CORP

# Таймаут запроса, секунды (минимум 5). По истечении — fallback на заглушку.
GIGACHAT_TIMEOUT=30

# Путь к SQLite-файлу. Локально можно не задавать (создастся backend/data/).
# В Docker: /data/bizradar/bizradar.db (именованный volume, см. compose).
# DATABASE_PATH=./data/bizradar.db

# ============================================================
# Пакетный загрузчик статистики Росстата (parsers/rosstat_loader.py)
# Ключей НЕ требует — данные открытые. Запускается раз в месяц, не в рантайме.
# ============================================================

# Страница opendata-набора «Численность населения, муниципальные образования».
# Загрузчик сам находит на ней свежий data-*.csv (версии файлов меняются).
# ROSSTAT_POPULATION_PAGE=https://rosstat.gov.ru/opendata/7708234640-population

# CSV-экспорт ЕМИСС, показатель 57039 «Среднедушевые денежные доходы населения»
# (fedstat.ru/indicator/57039 → Экспорт → CSV → ссылка сюда).
# Доходы публикуются только на уровне субъектов — городам ставится прокси.
# ROSSTAT_INCOME_URL=https://fedstat.ru/indicator/57039/export.csv

# Папка для скачанных датасетов (офлайн-перезапуск при недоступной сети).
# ROSSTAT_DATA_DIR=./data/rosstat
