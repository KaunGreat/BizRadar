# ============================================================
# BizRadar — конфигурация AI-слоя (services/ai_service.py)
# Скопируйте файл в .env и заполните значения.
# ============================================================

# Провайдер генерации бизнес-отчётов:
#   stub     — локальная эвристика-заглушка, работает без ключей и без сети
#              (режим по умолчанию для локальной разработки)
#   gigachat — реальный вызов GigaChat; при любой ошибке сервис сам
#              откатится на заглушку, эндпоинт не упадёт
LLM_PROVIDER=stub

# ------------------------------------------------------------
# GigaChat (Сбер) — долгоживущий авторизационный ключ.
#
# Где взять:
#   1. Кабинет разработчика Сбер: https://developers.sber.ru
#   2. Продукт «GigaChat API» -> вкладка «Управление доступом»
#   3. «Создать ключ» -> тип «Авторизационный ключ» (Authorization Key)
#
# Ключ — длинная base64-строка (100+ символов). НЕ коммитьте .env в git!
# ------------------------------------------------------------
GIGACHAT_AUTH_KEY=

# Модель:
#   GigaChat      — базовая (по умолчанию, хватает для отчётов)
#   GigaChat Pro  — сильнее в аналитике, дороже
#   GigaChat Max  — максимум качества для сложных кейсов
GIGACHAT_MODEL=GigaChat

# Scope доступа к API:
#   GIGACHAT_API_CORP — ключ выпущен на юрлицо
#   GIGACHAT_API_PERS — ключ выпущен на физлицо (личный кабинет)
GIGACHAT_SCOPE=GIGACHAT_API_CORP

# Таймаут запроса к GigaChat, секунды (минимум 5).
# По истечении — автоматический fallback на заглушку.
GIGACHAT_TIMEOUT=30
