# ============================================================
# BizRadar — фронтенд (Next.js). Скопируйте в frontend/.env.local
# (или добавьте переменные в окружение контейнера frontend в compose).
# Секреты в git не коммитятся.
# ============================================================

# Внутренний адрес бэкенда для Next.js rewrites (/api/* -> api):
#   в docker compose:  http://api:8000   (установлено в docker-compose.yml)
#   локально без Docker: http://localhost:8000 (дефолт в next.config.js)
# BACKEND_INTERNAL_URL=http://api:8000

# ------------------------------------------------------------
# Yandex Maps JS API — браузерный ключ. Префикс NEXT_PUBLIC_ обязателен:
# переменная попадает в клиентский бандл (карта рисуется в браузере).
#
# Где взять:
#   1. https://developer.tech.yandex.ru/services/
#   2. «JavaScript API и HTTP Геокодер» → создать проект → ключ
#
# Ограничение доменом (браузерный ключ публичен — ограничьте его!):
#   Кабинет → ключ → «Редактировать» → «Ограничения» →
#   «По HTTP Referer» → radar.example.com/* (и localhost:3000/* для разработки)
#
# Без ключа карта Matcher'а работает в офлайн-режиме (зоны рисуются
# локальной схемой) — сборка и запуск без переменной НЕ падают.
# ------------------------------------------------------------
NEXT_PUBLIC_YANDEX_MAPS_KEY=
